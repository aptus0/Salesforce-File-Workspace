{
    "name": "salesforce-file-workspace",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Open-source Salesforce File Workspace built with LWC and Apex.",
    "scripts": {
        "lint": "eslint force-app/main/default/lwc/**/*.js",
        "format:check": "prettier --check \"**/*.{cls,css,html,js,json,md,xml}\"",
        "validate": "npm run lint && npm run format:check"
    },
    "devDependencies": {
        "@lwc/eslint-plugin-lwc": "^3.3.0",
        "@prettier/plugin-xml": "^3.4.1",
        "@salesforce/eslint-config-lwc": "^4.0.0",
        "eslint": "^9.0.0",
        "eslint-plugin-jest": "^29.16.0",
        "prettier": "^3.3.0",
        "prettier-plugin-apex": "^2.2.0"
    }
}
